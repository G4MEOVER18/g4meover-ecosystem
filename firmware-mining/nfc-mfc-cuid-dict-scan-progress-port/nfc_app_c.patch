+void nfc_show_loading_dict_popup(void* context, const char* text, bool show) {
+    NfcApp* nfc = context;
+
+    if(show) {
+        loading_set_text(nfc->loading_dict, text);
+        // Raise timer priority so that the spinner animation can play
+        furi_timer_set_thread_priority(FuriTimerThreadPriorityElevated);
+        view_dispatcher_switch_to_view(nfc->view_dispatcher, NfcViewLoadingDict);
+    } else {
+        // Restore default timer priority
+        furi_timer_set_thread_priority(FuriTimerThreadPriorityNormal);
+        loading_reset_progress(nfc->loading_dict);
+    }
+}
+
+void nfc_set_loading_dict_progress(void* context, float progress) {
+    NfcApp* nfc = context;
+    loading_set_progress(nfc->loading_dict, progress);
+}
