diff --git a/CAN_Commander_FlipperZero/can_commander/can_commander.c b/CAN_Commander_FlipperZero/can_commander/can_commander.c
index c023e9b..755e1e5 100644
--- a/CAN_Commander_FlipperZero/can_commander/can_commander.c
+++ b/CAN_Commander_FlipperZero/can_commander/can_commander.c
@@ -4817,6 +4817,14 @@ static App* app_alloc(void) {
         goto fail;
     }
 
+    /* The stock Expansion service watches the same USART pins for a module
+     * detect edge and, once triggered, holds furi_hal_serial_control_acquire()
+     * for itself while it probes for the official handshake. Disable it for
+     * the lifetime of this app so our own cc_client_open() can actually get
+     * the handle instead of silently failing with "Not connected". */
+    app->expansion = furi_record_open(RECORD_EXPANSION);
+    expansion_disable(app->expansion);
+
     app->scene_manager = scene_manager_alloc(&cancommander_scene_handlers, app);
     if(!app->scene_manager) {
         goto fail;
@@ -4971,6 +4979,11 @@ static void app_free(App* app) {
         cc_client_free(app->client);
     }
 
+    if(app->expansion) {
+        expansion_enable(app->expansion);
+        furi_record_close(RECORD_EXPANSION);
+    }
+
     if(app->dbc_config_signals) {
         free(app->dbc_config_signals);
         app->dbc_config_signals = NULL;
