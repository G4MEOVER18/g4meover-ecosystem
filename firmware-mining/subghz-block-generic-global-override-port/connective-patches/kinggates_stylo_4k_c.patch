+              (instance->generic.serial & 0xFFFF);
+        instance->generic.data = subghz_protocol_blocks_reverse_key(fix, 53);
+
+        data = ((uint32_t)instance->generic.btn << 28) | (((uint32_t)0x0C) << 24) |
+               ((instance->generic.serial & 0xFF) << 16) | instance->generic.cnt;
+    }
