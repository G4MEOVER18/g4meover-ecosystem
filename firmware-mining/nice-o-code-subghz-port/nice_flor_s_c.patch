+/**
+ * Nice Flor-S cipher parameterised with a 16 bit installer code (Nice O-Code).
+ * Identical to subghz_protocol_nice_flor_s_encrypt() up to the final permutation, where
+ * the two bytes that plain Flor-S inverts outright are instead XORed with the installer
+ * code. Passing ic == NICE_FLOR_S_IC_PLAIN reproduces subghz_protocol_nice_flor_s_encrypt()
+ * bit for bit (see the verification in firmware-mining/repro-nice-o-code-subghz/repro.c).
+ * @param data 44-bit plaintext body (serial << 16 | cnt), already masked by the caller
+ *             for the parcel being sent (see subghz_protocol_nice_o_mask())
+ * @param ic Installer code, already XORed with the parcel's 16 bit mask by the caller
+ * @param file_name Full path to the rainbow table file
+ * @return data encrypted
+ */
+uint64_t subghz_protocol_nice_flor_s_encrypt_ic(uint64_t data, uint16_t ic, const char* file_name) {
+    uint8_t* p = (uint8_t*)&data;
+
+    uint8_t k = 0;
+    for(uint8_t y = 0; y < 2; y++) {
+        k = subghz_protocol_nice_flor_s_get_byte_in_file(file_name, p[0] & 0x1f);
+        subghz_protocol_decoder_nice_flor_s_magic_xor(p, k);
+
+        p[5] &= 0x0f;
+        p[0] ^= k & 0xe0;
+        k = subghz_protocol_nice_flor_s_get_byte_in_file(file_name, p[0] >> 3) + 0x25;
+        subghz_protocol_decoder_nice_flor_s_magic_xor(p, k);
+
+        p[5] &= 0x0f;
+        p[0] ^= k & 0x7;
+        if(y == 0) {
+            k = p[0];
+            p[0] = p[1];
+            p[1] = k;
+        }
+    }
+
+    p[5] = ~p[5] & 0x0f;
+    k = ~p[4];
+    p[4] = p[0] ^ (uint8_t)(ic >> 8);
+    p[0] = ~p[2];
+    p[2] = k;
+    k = p[1] ^ (uint8_t)ic;
+    p[1] = ~p[3];
+    p[3] = k;
+
+    return data;
+}
+
+/**
+ * Inverse of subghz_protocol_nice_flor_s_encrypt_ic(). ic == NICE_FLOR_S_IC_PLAIN
+ * reproduces the existing per-instance subghz_protocol_nice_flor_s_decrypt() bit for bit.
+ * @param data 44-bit ciphertext body of a single parcel
+ * @param ic Installer code, already XORed with the parcel's 16 bit mask by the caller
+ * @param file_name Full path to the rainbow table file
+ * @return data decrypted
+ */
+uint64_t subghz_protocol_nice_flor_s_decrypt_ic(uint64_t data, uint16_t ic, const char* file_name) {
+    uint8_t* p = (uint8_t*)&data;
+
+    uint8_t k = 0;
+
+    k = p[4] ^ (uint8_t)(ic >> 8);
+    p[5] = ~p[5];
+    p[4] = ~p[2];
+    p[2] = ~p[0];
+    p[0] = k;
+    k = p[3] ^ (uint8_t)ic;
+    p[3] = ~p[1];
+    p[1] = k;
+
+    for(uint8_t y = 0; y < 2; y++) {
+        k = subghz_protocol_nice_flor_s_get_byte_in_file(file_name, p[0] >> 3) + 0x25;
+        subghz_protocol_decoder_nice_flor_s_magic_xor(p, k);
+
+        p[5] &= 0x0f;
+        p[0] ^= k & 0x7;
+        k = subghz_protocol_nice_flor_s_get_byte_in_file(file_name, p[0] & 0x1f);
+        subghz_protocol_decoder_nice_flor_s_magic_xor(p, k);
+
+        p[5] &= 0x0f;
+        p[0] ^= k & 0xe0;
+
+        if(y == 0) {
+            k = p[0];
+            p[0] = p[1];
+            p[1] = k;
+        }
+    }
+
+    return data;
+}
