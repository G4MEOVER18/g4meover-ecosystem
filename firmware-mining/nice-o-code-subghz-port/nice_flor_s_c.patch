+/**
+ * Per-parcel obfuscation mask used by Nice O-Code. A button press puts 16 parcels on
+ * air, each re-encrypting the same (serial, cnt) with a different mask depending on its
+ * own index, so no two parcels of one press share ciphertext the way plain Flor-S's 16
+ * identical repeats do.
+ * @param n Parcel index, 0..15, recovered from a received frame with
+ *          subghz_protocol_nice_o_get_parcel()
+ * @param mask_32 Mask applied to the 28 bit serial before encryption (may be NULL)
+ * @param mask_16 Mask applied to the installer code before encryption (may be NULL)
+ */
+void subghz_protocol_nice_o_mask(uint8_t n, uint32_t* mask_32, uint16_t* mask_16) {
+    const uint32_t a = (uint32_t)(0x0Eu - n) & 0x0Fu;
+    const uint32_t b = (uint32_t)(n + 2u);
+    const uint32_t odd = (uint32_t)n & 1u;
+    const uint32_t c = b + (odd << 1);
+    const uint32_t bn = b & 0x0Fu;
+    const uint32_t cn = c & 0x0Fu;
+
+    uint32_t m = (a << 8) | (bn << 4) | (bn << 20) | (a << 24) | cn | (cn << 16);
+    m |= (((((b ^ (uint32_t)(0x0Eu - n) ^ c) & 0x0Fu) + (odd << 2)) << 12) & 0xFFFFu);
+
+    if(mask_32) *mask_32 = m & 0x0FFFFFFFu;
+    // REV16: swap the two bytes inside each halfword, then keep the low halfword
+    if(mask_16) *mask_16 = (uint16_t)(((m & 0x00FFu) << 8) | ((m >> 8) & 0x00FFu));
+}
+
+/**
+ * Recover the parcel index carried by a Nice O-Code packet.
+ * P0 (the button, bits 48..51) and P1 (bits 44..47) satisfy P1 = 0xF ^ P0 ^ n for every
+ * parcel of a press; everything below bit 44 is ciphertext and does not affect the result.
+ * @param data Full received frame, P0 and P1 in their on-air position
+ * @return Parcel index, 0..15
+ */
+uint8_t subghz_protocol_nice_o_get_parcel(uint64_t data) {
+    return (uint8_t)((((data >> 48) & 0x0Fu) ^ ((data >> 44) & 0x0Fu)) ^ 0x0Fu);
+}
