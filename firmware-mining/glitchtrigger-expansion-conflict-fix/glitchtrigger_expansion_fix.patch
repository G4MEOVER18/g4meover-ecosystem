diff --git a/glitch_trigger.c b/glitch_trigger.c
index 9bee5d5..20b88af 100644
--- a/glitch_trigger.c
+++ b/glitch_trigger.c
@@ -77,6 +77,16 @@ static GlitchApp* glitch_app_alloc(void) {
     app->gui = furi_record_open(RECORD_GUI);
     app->notifications = furi_record_open(RECORD_NOTIFICATION);
 
+    /* The Sweep screen's UART auto-hit (helpers/glitch_serial.c) acquires
+     * FuriHalSerialIdUsart on pins 13/14 - the same UART the stock Expansion
+     * system service watches by default. Hold it disabled for the app's whole
+     * life (not just while a UART sweep runs): the glitch-out/trigger-in/
+     * feedback pins already monopolise the expansion port for this app's own
+     * wiring, so co-existing with an official expansion module is not a case
+     * this app supports anyway. */
+    app->expansion = furi_record_open(RECORD_EXPANSION);
+    expansion_disable(app->expansion);
+
     app->view_dispatcher = view_dispatcher_alloc();
     app->scene_manager = scene_manager_alloc(&glitch_scene_handlers, app);
 
@@ -162,6 +172,11 @@ static void glitch_app_free(GlitchApp* app) {
     glitch_serial_free(app->serial);
     glitch_engine_free(app->engine);
 
+    /* re-enable expansion detection only after the UART/GPIO it watches are
+     * both fully released above (glitch_serial_free()/glitch_engine_free()) */
+    expansion_enable(app->expansion);
+    furi_record_close(RECORD_EXPANSION);
+
     furi_record_close(RECORD_NOTIFICATION);
     furi_record_close(RECORD_GUI);
 
