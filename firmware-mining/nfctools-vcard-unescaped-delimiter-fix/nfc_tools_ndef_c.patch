+// ── vCard 3.0 TEXT escaping (RFC 6350 §3.4) ─────────────────────────────────
+// Backslash, semicolon and comma are structural delimiters in vCard TEXT
+// values -- N and ADR are themselves semicolon-separated subfields, so an
+// unescaped ';' from free-text user input (e.g. a company name like
+// "Acme; Inc.") re-slices those subfields on every vCard-reading device.
+// Embedded newlines are escaped the same way; a bare '\r' is dropped
+// defensively (the keyboard input this feeds from cannot produce one).
+static void vcard_escape(const char* src, char* dest, size_t dest_size) {
+    size_t j = 0;
+    for(size_t i = 0; src[i] != '\0' && j + 3 < dest_size; i++) {
+        char c = src[i];
+        if(c == '\\' || c == ';' || c == ',') {
+            dest[j++] = '\\';
+            dest[j++] = c;
+        } else if(c == '\n') {
+            dest[j++] = '\\';
+            dest[j++] = 'n';
+        } else if(c == '\r') {
+            continue;
+        } else {
+            dest[j++] = c;
+        }
+    }
+    dest[j] = '\0';
+}
