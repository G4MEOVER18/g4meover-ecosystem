+// Found keys otherwise only live on this card: they reach MfClassicData, the dump and the
+// per-UID key cache, but never the shared user dictionary every dict attack reads from. The
+// CUID dictionary case is the worst of it -- those keys are per-UID and reachable nowhere else,
+// so a card cloned to a magic tag could not later be unlocked again from the clone alone.
+static void nfc_scene_menu_add_save_keys_mf_classic(NfcApp* instance, const MfClassicData* data) {
+    if((data->key_a_mask | data->key_b_mask) == 0) return;
+
+    submenu_add_item(
+        instance->submenu,
+        "Save Keys to Dictionary",
+        SubmenuIndexSaveKeys,
+        nfc_protocol_support_common_submenu_callback,
+        instance);
+}
+
+static bool nfc_scene_menu_on_event_save_keys_mf_classic(NfcApp* instance, uint32_t event) {
+    if(event != SubmenuIndexSaveKeys) return false;
+
+    scene_manager_next_scene(instance->scene_manager, NfcSceneMfClassicSaveKeys);
+
+    return true;
+}
+
