--- a/app.c	2026-10-23 06:27:50.618903126 +0000
+++ b/app.c	2026-10-23 06:28:17.965303872 +0000
@@ -157,6 +157,12 @@
     app->frequency = subghz_setting_get_default_frequency(app->setting);
     app->modulation = 0; /* Defaults to ProtoViewModulations[0]. */
 
