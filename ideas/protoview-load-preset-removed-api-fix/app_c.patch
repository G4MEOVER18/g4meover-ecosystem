+     * Subghz app. Own its lifetime for as long as this app runs. */
+    subghz_devices_init();
+
     furi_hal_power_suppress_charge_enter();
     app->running = 1;
 
@@ -172,6 +178,9 @@
     // Put CC1101 on sleep, this also restores charging.
     radio_sleep(app);
 
