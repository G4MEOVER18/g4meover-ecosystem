+    s_flipperCounter = s_rfCtrPrefs.getUInt(UKFE_RF_COUNTER_PREF_KEY, 0);
+    s_rfCtrPersistedFloor = ukfe_rf_counter_initial_reserve(s_flipperCounter, UKFE_RF_COUNTER_MARGIN);
