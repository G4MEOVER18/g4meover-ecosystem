+// Pro-Satellit-Anti-Replay-Fenster fuer Antworten: ein gemeinsames Fenster ueber alle
+// Absender wuerde (wie beim bereits behobenen Hub-Broadcast/Relay-Fund) unabhaengige
+// Zaehlerraeume verschiedener Satelliten gegenseitig blockieren, daher ein eigener
+// Zaehler je Absender-MAC.
+#define SAT_COUNTER_TABLE_SIZE 8u
+typedef struct { uint8_t mac[6]; uint32_t counter; bool used; } SatCounterEntry;
+static SatCounterEntry s_satCounters[SAT_COUNTER_TABLE_SIZE];
+
+// Liefert das Anti-Replay-Fenster des angegebenen Absenders (legt bei erstem Kontakt
+// einen neuen Eintrag mit Startwert 0 an). NULL nur, wenn bereits SAT_COUNTER_TABLE_SIZE
+// unterschiedliche Absender-MACs aufgetreten sind -- faellt dann auf den bisherigen,
+// ungeprueften Pfad zurueck statt einen weiteren legitimen Satelliten grundlos abzuweisen.
+static uint32_t* sat_counter_slot(const uint8_t mac[6]) {
+    for (size_t i = 0; i < SAT_COUNTER_TABLE_SIZE; i++) {
+        if (s_satCounters[i].used && memcmp(s_satCounters[i].mac, mac, 6) == 0)
+            return &s_satCounters[i].counter;
+    }
+    for (size_t i = 0; i < SAT_COUNTER_TABLE_SIZE; i++) {
+        if (!s_satCounters[i].used) {
+            memcpy(s_satCounters[i].mac, mac, 6);
+            s_satCounters[i].counter = 0;
+            s_satCounters[i].used = true;
+            return &s_satCounters[i].counter;
+        }
+    }
+    return NULL;
+}
