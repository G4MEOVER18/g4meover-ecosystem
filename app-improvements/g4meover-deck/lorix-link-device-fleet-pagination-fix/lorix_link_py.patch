+def _get_page(path: str, key: str) -> tuple[int, dict | str, int | None]:
+    """Wie _get(), liest zusaetzlich den X-Total-Count-Header (seitenbasierte
+    Pagination laut TTN-API-Dokumentation: limit/page-Parameter, X-Total-Count
+    als Gesamtzahl der fuer diesen Key sichtbaren Objekte)."""
+    req = urllib.request.Request(BASE + path)
+    req.add_header("Authorization", "Bearer " + key)
+    try:
+        with urllib.request.urlopen(req, timeout=15) as r:
+            total = r.headers.get("X-Total-Count")
+            return r.status, json.loads(r.read().decode()), (int(total) if total else None)
+    except urllib.error.HTTPError as e:
+        return e.code, e.read().decode(), None
+    except Exception as e:  # noqa: BLE001
+        return -1, str(e), None
+
