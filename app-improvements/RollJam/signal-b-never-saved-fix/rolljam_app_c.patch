             // Proceed to replay even if Signal B capture timed out —
             // Signal A is what unlocks the car.
             if(!captured) {
+                app->signal_b_saved = false;
                 snprintf(app->status, sizeof(app->status), "B skipped — replaying A");
+            } else {
+                // Signal B ist der "Spare"-Code des Angriffs — ohne diese
+                // Sicherung auf SD existiert er nur im RAM dieses App-Laufs
+                // und ist beim Verlassen der App unwiderruflich weg, egal
+                // was der DONE-Bildschirm behauptet.
+                app->signal_b_saved =
+                    rolljam_rf_save_signal(&app->signal_b, app->frequency, "signal_b");
+                snprintf(
+                    app->status,
+                    sizeof(app->status),
+                    app->signal_b_saved ? "B saved — replaying A" : "B save FAILED — replaying A");
             }
