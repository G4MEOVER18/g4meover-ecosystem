diff --git a/rolljam_app.c b/rolljam_app.c
index e30d56a..0ee4419 100644
--- a/rolljam_app.c
+++ b/rolljam_app.c
@@ -107,6 +107,21 @@ static void rj_input_cb(InputEvent* ev, void* ctx) {
         return;
     }
 
+    // Left button = the "Exit" hint drawn via elements_button_left() on the
+    // IDLE and DONE screens. app->quit = true mirrors InputKeyBack above
+    // (both really mean "end the app", not "cancel the current phase") --
+    // today app->state is already IDLE/DONE whenever this fires, so the
+    // abort-resolution block's state check alone would already end the app,
+    // but setting quit explicitly keeps that invariant from depending on
+    // which half of the OR condition happens to be true.
+    if(ev->key == InputKeyLeft) {
+        if(app->state == ROLLJAM_IDLE || app->state == ROLLJAM_DONE) {
+            app->abort = true;
+            app->quit  = true;
+        }
+        return;
+    }
+
     // Right button = Abort: bricht NUR die laufende Phase ab (zurueck ins
     // Menu) -- genauso auf jedem Bildschirm, der per
     // elements_button_right(canvas, "Abort") diesen Hinweis zeichnet.
