+    s_rfCtrPrefs.begin(UKFE_RF_COUNTER_PREF_NS, false);
+    lastCounter = s_rfCtrPrefs.getUInt(UKFE_RF_COUNTER_PREF_KEY_868, 0);
+    s_rf868PersistedFloor = ukfe_rf_counter_initial_reserve(lastCounter, UKFE_RF_COUNTER_MARGIN);
+    s_rfCtrPrefs.putUInt(UKFE_RF_COUNTER_PREF_KEY_868, s_rf868PersistedFloor);
+    enowCounter = s_rfCtrPrefs.getUInt(UKFE_RF_COUNTER_PREF_KEY_ENW, 0);
