+// ---- Anti-Replay-Fenster von lastCounter/enowCounter ueberleben einen Neustart (NVS) ----
+// Ohne das setzt jeder Reset/Crash/Akku-leer/OTA-Update beide Fenster auf 0 zurueck und
+// oeffnet damit fuer jedes zuvor mitgeschnittene, aber gueltig signierte Frame (868 VOM
+// Flipper ODER ESP-NOW vom WROOM-Relay) das Replay-Fenster erneut. Zwei unabhaengige
+// Floors, da beide Zaehler laut obigem Kommentar bereits als getrennte Fenster gefuehrt
+// werden. Reserve-mit-Sicherheitsspanne-Logik identisch zum bereits in
+// usb-army-penetrator/heltec-v4-hub/lilygo-ukfe-rx/g4meover-wifi-relay verifizierten Muster.
+#define UKFE_RF_COUNTER_MARGIN       10u
+#define UKFE_RF_COUNTER_PREF_NS      "g4meoverHtk"
+#define UKFE_RF_COUNTER_PREF_KEY_868 "rf868Ctr"
+#define UKFE_RF_COUNTER_PREF_KEY_ENW "rfEnowCtr"
+static Preferences s_rfCtrPrefs;
+static uint32_t    s_rf868PersistedFloor = 0;
+static uint32_t    s_rfEnowPersistedFloor = 0;
+
+static uint32_t ukfe_rf_counter_initial_reserve(uint32_t loaded, uint32_t margin) {
+    return loaded + margin;
+}
+static bool ukfe_rf_counter_needs_bump(uint32_t counter, uint32_t reserved_up_to,
+                                       uint32_t margin, uint32_t* new_reserved_up_to) {
+    if(counter + margin / 2 < reserved_up_to) return false;
+    *new_reserved_up_to = counter + margin;
+    return true;
+}
+
 ICACHE_RAM_ATTR void onDio1() {
     rxFlag = true;
 }
