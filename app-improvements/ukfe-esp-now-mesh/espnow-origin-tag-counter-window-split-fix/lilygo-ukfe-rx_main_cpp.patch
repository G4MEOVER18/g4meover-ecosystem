+// ESP-NOW-Envelope: 1 Byte Ursprungs-Tag VOR dem ukfe_rf-Frame (ausserhalb des
+// MAC/CRC-geschuetzten Bereichs -- reine Routing-Info, kein Sicherheitsmerkmal).
+// Trennt Hub-Broadcasts (hub_broadcast(), eigener s_txCounter-Zaehlerraum) von
+// relayten Flipper-Frames (relay_frame(), Flipper-Zaehlerraum) in zwei eigene
+// Anti-Replay-Fenster, statt beide in ein gemeinsames last_counter-Fenster zu
+// mischen. MUSS mit dem Hub (heltec-v4-hub) uebereinstimmen.
+#define ESPNOW_ORIGIN_RELAY   0x00
+#define ESPNOW_ORIGIN_HUBCMD  0x01
+
 // ---- ESP-NOW-Empfang (Callback setzt nur Flag; HID/Delay laufen in loop) ----
 static volatile bool enowFlag = false;
 static uint8_t  enowBuf[UKFE_RF_MAX_FRAME];
 static volatile int enowLen = 0;
-static uint32_t enowCounter = 0;     // Anti-Replay-Fenster (WiFi)
+static uint32_t enowCounter = 0;     // Anti-Replay-Fenster: relayte Flipper-Frames (ESPNOW_ORIGIN_RELAY)
+static uint32_t enowBroadcastCounter = 0;  // Anti-Replay-Fenster: Hub-eigene Broadcasts (ESPNOW_ORIGIN_HUBCMD)
 static uint32_t rxCount = 0, okCount = 0;
 static uint8_t  enowSenderMac[6] = {0};   // MAC des WROOM (fuer ACK-Rueckweg)
 static uint32_t respCounter = 0;
+static volatile uint8_t enowOrigin = ESPNOW_ORIGIN_RELAY;  // Ursprungs-Tag des gepufferten Frames
 
 void onEspNowRecv(const uint8_t* mac, const uint8_t* data, int len) {
